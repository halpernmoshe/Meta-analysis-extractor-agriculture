# ===== Still exclude: secrets, binaries, caches, personal files =====
.env
.env.local
*.key
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.docx
.claude/
tmpclaude-*
nul
Thumbs.db
.DS_Store
~$*

# Exclude raw PDFs (copyright)
input/
input_*/

# Exclude personal notes, session logs, overnight reports
MORNING_*.md
OVERNIGHT_*.md
NEXT_SESSION_*.md
COORDINATOR_STATUS.md
CURRENT_WORK_SUMMARY.md
KIMI_SESSION_CONTEXT.md
Backup_for_restart.md
MORNING_SUMMARY.md
