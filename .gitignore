AI_EXTRACTION_INSIGHTS.md
CONFUSION_HANDLING_GUIDE.md
EXPERIMENT_*.md
LOLADZE_COMPARISON_METHODOLOGY.md
LOLADZE_GT_ALIGNMENT.md
validator_improvement_conclusions.md

# Exclude paper drafts (except the primary)
PAPER_FULL_DRAFT_v*.md
PAPER_GEMINI_*.md
PAPER_REFINED_*.md
PAPER_ABSTRACT_DRAFT.md
PAPER_CONCLUSION_DRAFT.md
